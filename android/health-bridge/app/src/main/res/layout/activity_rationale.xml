<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How Cortex Health Bridge uses your data"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:text="This app reads activity, heart rate, sleep, exercise and body measurements from Health Connect and sends daily totals, exercise sessions and weight entries to your own Cortex server (coretex.uk) over HTTPS. It only reads data; it never writes to Health Connect. Data is not shared with third parties." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrivacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Open privacy policy" />
</LinearLayout>
